rules_version = '2';
// חוקי אבטחה – מכון משפטי ארץ
// מדביקים ב-Firebase Console → Firestore Database → Rules → Publish
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- זהות ותפקידים ----------
    // כניסה רק עם חשבון Google מאומת
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function allowedDoc() { return /databases/$(database)/documents/allowedEmails/$(myEmail()); }
    function myRole() { return get(allowedDoc()).data.role; }
    function hasRole(roles) { return signedIn() && exists(allowedDoc()) && myRole() in roles; }

    // כל אנשי הצוות (מי שנמצא ברשימת המורשים)
    function isTeam() { return hasRole(['admin', 'head', 'rabbi', 'staff', 'researcher', 'research_coord', 'course_manager']); }
    function isAdmin() { return hasRole(['admin']); }
    // ניהול קשרים ושו"ת
    function isStaff() { return hasRole(['admin', 'head', 'rabbi', 'staff']); }
    function isEditor() { return hasRole(['admin', 'head', 'staff']); }
    // מחקר
    function isResearchAdmin() { return hasRole(['admin', 'head', 'research_coord']); }
    function isResearcher() { return hasRole(['researcher']); }
    // השתלמויות
    function isCourseAll() { return hasRole(['admin', 'head', 'staff']); }           // כל ההשתלמויות
    function isCourseTeam() { return hasRole(['admin', 'head', 'staff', 'course_manager']); }
    function courseDoc(cid) { return get(/databases/$(database)/documents/courses/$(cid)).data; }
    function managesCourse(cid) {
      return isCourseAll() || (hasRole(['course_manager']) && myEmail() in courseDoc(cid).managerEmails);
    }
    // הרשאת גישה של משתלם מאושר – מסמך courseAccess/השתלמות_מייל שהרכז יוצר באישור
    function registeredTo(cid) {
      return signedIn() && exists(/databases/$(database)/documents/courseAccess/$(cid + '_' + myEmail()));
    }

    // ---------- משתמשים מורשים ----------
    match /allowedEmails/{email} {
      allow get: if signedIn() && email == myEmail();
      allow read: if isTeam();
      allow create, delete: if isAdmin() && email == email.lower();
      allow update: if isAdmin()
        || (isTeam() && email == myEmail()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'lastLogin']));
    }

    // ---------- ניהול קשרים ----------
    match /contacts/{id} {
      allow read, create: if isStaff();
      allow update: if isEditor()
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['firstName', 'lastName', 'email', 'emailKey', 'phone', 'phoneKey', 'city', 'consentEmail']));
      allow delete: if isAdmin();
    }
    match /activities/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isEditor();
    }
    match /savedLists/{id} {
      allow read, write: if isStaff();
    }

    // ---------- שו"ת ----------
    match /questions/{id} {
      allow create: if isStaff() || (
        request.resource.data.keys().hasOnly(['firstName', 'lastName', 'email', 'phone', 'topic', 'text', 'consentEmail', 'status', 'contactId', 'origin', 'createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.contactId == null
        && request.resource.data.origin == 'טופס באתר'
        && request.resource.data.createdAt == request.time
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 5000
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.firstName is string && request.resource.data.firstName.size() <= 60
        && request.resource.data.lastName is string && request.resource.data.lastName.size() <= 60
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.consentEmail is bool
        && request.resource.data.topic is string && request.resource.data.topic.size() <= 60
      );
      allow read, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /publicQA/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ---------- הגדרות (קטגוריות, תגיות, חשבונות זום) ----------
    match /settings/{id} {
      allow read: if true;
      allow write: if hasRole(['admin', 'head']);
    }

    // ---------- מחקר: דיווח חודשי ----------
    // חוקר רואה וכותב רק את שלו; רכז מחקר, רכז הרכזים ומנהל רואים את כולם ויכולים להוסיף הערה
    // מזהה המסמך: מייל_YYYY-MM
    match /monthly/{id} {
      allow read: if isResearchAdmin() || (isResearcher() && resource.data.researcherEmail == myEmail());
      allow create: if isResearcher() && request.resource.data.researcherEmail == myEmail()
        && request.resource.data.month is string && request.resource.data.month.size() == 7
        && id == myEmail() + '_' + request.resource.data.month
        && request.resource.data.keys().hasOnly(['researcherEmail', 'researcherName', 'month', 'achieved', 'nextGoal', 'createdAt', 'updatedAt'])
        && request.resource.data.achieved.size() < 20000 && request.resource.data.nextGoal.size() < 20000;
      allow update: if (isResearcher() && resource.data.researcherEmail == myEmail()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['achieved', 'nextGoal', 'updatedAt'])
            && request.resource.data.achieved.size() < 20000 && request.resource.data.nextGoal.size() < 20000)
        || (isResearchAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coordComment', 'coordAt', 'coordBy']));
      allow delete: if isAdmin();
    }

    // ---------- השתלמויות ----------
    // השתלמות שאינה טיוטה גלויה לכולם (לדף הנחיתה)
    match /courses/{cid} {
      allow read: if resource.data.status != 'draft' || isCourseTeam();
      allow create: if isCourseAll()
        || (hasRole(['course_manager']) && myEmail() in request.resource.data.managerEmails);
      allow update: if managesCourse(cid);
      allow delete: if hasRole(['admin', 'head']);
    }
    // מפגשים – פרטים כלליים גלויים לכולם; קישור הזום וההקלטה בנפרד
    match /sessions/{sid} {
      allow read: if true;
      allow create: if managesCourse(request.resource.data.courseId);
      allow update: if managesCourse(resource.data.courseId);
      allow delete: if isCourseTeam() && (resource == null || managesCourse(resource.data.courseId));
    }
    // עיצוב המודעה ורקע הזום של השתלמות
    match /courseMedia/{cid} {
      allow read: if true;
      allow write: if managesCourse(cid);
    }
    // קישור זום – רק לצוות ולנרשמים
    match /sessionPrivate/{sid} {
      allow read: if isCourseTeam() || registeredTo(resource.data.courseId);
      allow create: if managesCourse(request.resource.data.courseId);
      allow update: if managesCourse(resource.data.courseId);
      allow delete: if isCourseTeam() && (resource == null || managesCourse(resource.data.courseId));
    }
    // הקלטות – לצוות, ולנרשמים רק כשהרכז פתח את ההקלטות
    match /recordings/{sid} {
      allow read: if isCourseTeam()
        || (registeredTo(resource.data.courseId) && courseDoc(resource.data.courseId).recordingsOpen == true);
      allow create: if managesCourse(request.resource.data.courseId);
      allow update: if managesCourse(resource.data.courseId);
      // מחיקה של מסמך שלא קיים (מפגש בלי הקלטה) מותרת לצוות
      allow delete: if isCourseTeam() && (resource == null || managesCourse(resource.data.courseId));
    }
    // הרשמות – כל אחד יכול להירשם (בלי חשבון); ההרשמה ממתינה לאישור הרכז
    // המפגש שייך להשתלמות ומתקיים היום (שעון ישראל, בקירוב UTC+2)
    function sessionIsToday(sid, cid) {
      let s = get(/databases/$(database)/documents/sessions/$(sid)).data;
      let t = request.time + duration.value(2, 'h');
      return s.courseId == cid && s.date == string(t.year()) + '-' + (t.month() < 10 ? '0' : '') + string(t.month())
        + '-' + (t.day() < 10 ? '0' : '') + string(t.day());
    }
    match /registrations/{rid} {
      allow read: if isCourseAll()
        || (hasRole(['course_manager']) && myEmail() in resource.data.managerEmails)
        || (signedIn() && resource.data.email == myEmail());
      allow create: if (
          request.resource.data.keys().hasOnly(['courseId', 'email', 'firstName', 'lastName', 'phone', 'city', 'institution', 'address',
             'consentEmail', 'status', 'managerEmails', 'scholarship', 'note', 'source', 'createdAt'])
          && request.resource.data.status == 'pending'
          && request.resource.data.source == 'טופס באתר'
          && courseDoc(request.resource.data.courseId).status == 'open'
          && request.resource.data.managerEmails == courseDoc(request.resource.data.courseId).managerEmails
          && request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 120
          && request.resource.data.firstName is string && request.resource.data.firstName.size() > 0 && request.resource.data.firstName.size() <= 60
          && request.resource.data.lastName is string && request.resource.data.lastName.size() <= 60
          && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
          && request.resource.data.get('city', '') is string && request.resource.data.get('city', '').size() <= 60
          && request.resource.data.get('institution', '') is string && request.resource.data.get('institution', '').size() <= 120
          && request.resource.data.get('address', '') is string && request.resource.data.get('address', '').size() <= 200
          && request.resource.data.note is string && request.resource.data.note.size() <= 1000
          && request.resource.data.consentEmail is bool
          // אם בהשתלמות הוגדר שהסכמה לדיוור היא חובה
          && (courseDoc(request.resource.data.courseId).get('formFields', {}).get('consent', 'required') != 'required'
              || request.resource.data.consentEmail == true)
          && (!('scholarship' in request.resource.data) || (request.resource.data.scholarship.status == 'pending'
                && request.resource.data.scholarship.reason.size() <= 1000))
          && request.resource.data.createdAt == request.time
        ) || (isCourseTeam() && managesCourse(request.resource.data.courseId));
      // הרכז מעדכן הכול; המשתלם יכול לעדכן פרטי קשר, לבטל את ההרשמה שלו, ולסמן "אני נוכח" ביום המפגש
      allow update: if managesCourse(resource.data.courseId)
        || (signedIn() && resource.data.email == myEmail()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'city', 'institution', 'address', 'consentEmail', 'status', 'updatedAt'])
            && request.resource.data.status in [resource.data.status, 'cancelled'])
        || (signedIn() && resource.data.email == myEmail() && resource.data.status == 'registered'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendance', 'selfCheckin'])
            && request.resource.data.selfCheckin.keys().hasOnly(['sid', 'at'])
            && request.resource.data.selfCheckin.at == request.time
            && request.resource.data.attendance.diff(resource.data.get('attendance', {})).affectedKeys().hasOnly([request.resource.data.selfCheckin.sid])
            && request.resource.data.attendance[request.resource.data.selfCheckin.sid] == true
            && sessionIsToday(request.resource.data.selfCheckin.sid, resource.data.courseId));
      allow delete: if hasRole(['admin', 'head']);
    }
    // חומרי לימוד לכל מפגש (קישורים) – לנרשמים מאושרים ולצוות
    match /materials/{sid} {
      allow read: if isCourseTeam() || registeredTo(resource.data.courseId);
      allow create: if managesCourse(request.resource.data.courseId);
      allow update: if managesCourse(resource.data.courseId);
      allow delete: if isCourseTeam() && (resource == null || managesCourse(resource.data.courseId));
    }
    // משוב בסוף השתלמות – מזהה: השתלמות_מייל. המשתלם כותב רק את שלו, הרכז רואה את כולם
    match /feedback/{fid} {
      allow get: if signedIn() && fid == fid.split('_')[0] + '_' + myEmail();
      allow read: if managesCourse(resource.data.courseId);
      allow create, update: if registeredTo(request.resource.data.courseId)
        && fid == request.resource.data.courseId + '_' + myEmail()
        && request.resource.data.email == myEmail()
        && request.resource.data.keys().hasOnly(['courseId', 'email', 'name', 'overall', 'content', 'lecturers', 'recommend', 'comments', 'at'])
        && request.resource.data.comments is string && request.resource.data.comments.size() <= 3000
        && request.resource.data.at == request.time;
    }
    // הרשאות גישה לאזור האישי – מזהה: השתלמות_מייל
    match /courseAccess/{aid} {
      allow read: if isCourseTeam() || (signedIn() && resource.data.email == myEmail());
      allow create, update: if managesCourse(request.resource.data.courseId)
        && aid == request.resource.data.courseId + '_' + request.resource.data.email;
      allow delete: if (isCourseTeam() && (resource == null || managesCourse(resource.data.courseId)))
        || (signedIn() && resource.data.email == myEmail());
    }
    // ---------- הסרה מרשימת התפוצה ----------
    // unsubTokens / unsubByEmail נכתבים רק על ידי הסקריפט (אין גישה מהאתר).
    // בדף ההסרה כותבים optouts/{מזהה} – רק עם מזהה אמיתי ורק עם המייל שהמזהה שייך לו.
    match /optouts/{t} {
      allow read: if isTeam();
      allow create, update: if exists(/databases/$(database)/documents/unsubTokens/$(t))
        && request.resource.data.email == get(/databases/$(database)/documents/unsubTokens/$(t)).data.email
        && request.resource.data.keys().hasOnly(['email', 'reason', 'at'])
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 60
        && request.resource.data.at == request.time;
      allow delete: if isEditor();
    }
    // ---------- יומן שינויים: כל איש צוות כותב (רק בשמו), רק מנהל מערכת קורא, אי אפשר לשנות או למחוק ----------
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isTeam() && request.resource.data.by == myEmail() && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['action', 'target', 'details', 'by', 'at']);
    }
    // מידע פרטי של הסקריפט (כתובת ה-Webhook של Jgive) – רק מנהל מערכת
    match /private/{id} {
      allow read: if isAdmin();
    }
    // ---------- ספרים ----------
    // עדכונים מ-Jgive (נכתבים על ידי הסקריפט)
    match /jgiveInbox/{id} {
      allow read: if isEditor();
      allow update: if isEditor() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['processed', 'processedAt', 'contactId', 'orderId', 'note']);
      allow delete: if isAdmin();
    }
    // הזמנות מהחנות – כל אחד יכול להזמין (סטטוס "חדשה" בלבד); הצוות מנהל
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['items', 'total', 'firstName', 'lastName', 'email', 'phone', 'address', 'delivery', 'note', 'consentEmail', 'status', 'createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 30
        && request.resource.data.total is number && request.resource.data.total >= 0 && request.resource.data.total < 100000
        && request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 120
        && request.resource.data.firstName is string && request.resource.data.firstName.size() <= 60
        && request.resource.data.lastName is string && request.resource.data.lastName.size() <= 60
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.address is string && request.resource.data.address.size() <= 300
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000
        && request.resource.data.consentEmail is bool;
      allow read, update: if isEditor();
      allow delete: if isAdmin();
    }
    // מוסדות (בתי כנסת וכו') וחלוקת ספרים
    match /institutions/{id} {
      allow read: if isStaff();
      allow write: if isEditor();
    }
    match /distributions/{id} {
      allow read: if isStaff();
      allow write: if isEditor();
    }
    // מיילים מתוזמנים – נשלחים על ידי הסקריפט בחשבון ה-Gmail של המכון (שעוקף את החוקים בהרשאת IAM)
    match /mailQueue/{id} {
      allow read: if hasRole(['admin', 'head']) || (isTeam() && resource.data.createdBy == myEmail());
      allow create: if isTeam() && request.resource.data.createdBy == myEmail() && request.resource.data.status == 'scheduled'
        && request.resource.data.recipients.size() <= 400;
      // ביטול בלבד, ורק לפני שהשליחה התחילה
      allow update: if (hasRole(['admin', 'head']) || (isTeam() && resource.data.createdBy == myEmail()))
        && resource.data.status == 'scheduled' && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy']);
    }
    // יומן מיילים שנשלחו מהמערכת
    match /mailLog/{id} {
      allow read: if isTeam();
      allow create: if isTeam() && request.resource.data.by == myEmail();
    }
  }
}
